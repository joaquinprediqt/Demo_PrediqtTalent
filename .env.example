# Copia este archivo como .env antes de levantar el proyecto con Docker:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# Ninguno de estos valores es secreto: la demo no se conecta todavia a ningun
# servicio externo. .env esta en .gitignore de todos modos.

# --------------------------------------------------------------------------
# En uso hoy por la aplicacion
# --------------------------------------------------------------------------

# Unica variable que la app lee en el codigo (lib/auth/sesion.ts): en
# "production" la cookie de sesion se marca como secure. Dejala en production
# dentro de Docker; en local con `npm run dev` Next la pone en development sola.
NODE_ENV=production

# Puerto y direccion de escucha del servidor standalone. HOSTNAME debe ser
# 0.0.0.0 dentro del contenedor; con 127.0.0.1 el mapeo de puertos no funciona.
PORT=3000
HOSTNAME=0.0.0.0

# --------------------------------------------------------------------------
# Todavia no se leen: quedan declaradas para cuando conectemos los servicios
# reales. Hoy la URL de Academy esta fija en lib/learning/academy.ts y el
# inicio de sesion es contra la base SQLite local.
# --------------------------------------------------------------------------

# Prediqt Academy (Moodle). Para sincronizar el avance real de los cursos hace
# falta que un administrador habilite los Web Services y emita un token.
# ACADEMY_BASE_URL=https://academy.prediqt.ec
# ACADEMY_WS_TOKEN=

# Azure Entra ID / Office 365, cuando reemplace al inicio de sesion local.
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
